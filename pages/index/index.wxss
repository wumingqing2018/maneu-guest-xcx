/* ==========================================================
   pages/index/index.wxss
   ----------------------------------------------------------
   Apple 风格设计系统 —— 首页
   ----------------------------------------------------------
   色板
     bg        #FBFBFD  Apple.com 页面底色
     surface   #FFFFFF  卡片
     text      #1D1D1F  主文字
     text-2    #86868B  次文字
     hairline  rgba(0,0,0,.08)
   字体   SF Pro Display → SF Pro Text → PingFang SC
   间距   8 / 16 / 24 / 32 / 48 / 64 (rpx)
   ========================================================== */

page {
  background: #fbfbfd;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
    "SF Pro Text", "Helvetica Neue", "PingFang SC", "Microsoft YaHei",
    sans-serif;
  -webkit-font-smoothing: antialiased;
  color: #1d1d1f;
}

.page {
  padding-bottom: calc(64rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ==================== Hero 大标题 ==================== */
.hero {
  padding: 88rpx 48rpx 56rpx;
}

.hero__title {
  display: block;
  font-size: 88rpx;
  font-weight: 700;
  letter-spacing: -3rpx;
  line-height: 1.02;
  color: #1d1d1f;
  margin-bottom: 16rpx;
}

.hero__subtitle {
  display: block;
  font-size: 30rpx;
  font-weight: 400;
  color: #86868b;
  letter-spacing: 0.4rpx;
}

/* ==================== 首图卡片 ==================== */
.feature {
  margin: 0 32rpx 48rpx;
  border-radius: 36rpx;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03),
    0 16rpx 40rpx rgba(0, 0, 0, 0.06);
  transition: transform 0.32s cubic-bezier(0.25, 0.1, 0.25, 1),
    box-shadow 0.32s cubic-bezier(0.25, 0.1, 0.25, 1);
}

.feature--hover {
  transform: scale(0.98);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.feature__gif {
  width: 100%;
  display: block;
}

.feature__img {
  padding-top: 30rpx;
  padding-bottom: 40rpx;
  width: 100%;
  display: block;
}

/* ==================== 分区标题 ==================== */
.section {
  padding: 48rpx;
}

.section__title {
  font-size: 60rpx;
  font-weight: 700;
  letter-spacing: -1.2rpx;
  color: #1d1d1f;
}

/* ==================== 横向滚动列表 ==================== */
.hscroll {
  width: 100%;
  box-sizing: border-box;
}

.hscroll__spacer {
  flex: 0 0 16rpx;
  width: 32rpx;
}

.hscroll__inner {
  display: flex;
  padding: 0 32rpx;
  box-sizing: content-box;
}

.hscroll__item {
  flex-shrink: 0;
  width: 300rpx;
  height: 300rpx;
  margin-right: 20rpx;
  border-radius: 28rpx;
  overflow: hidden;
  background: #ffffff;
  transition: transform 0.3s cubic-bezier(0.25, 0.1, 0.25, 1),
    box-shadow 0.3s cubic-bezier(0.25, 0.1, 0.25, 1);
}

/* 最后一个卡片右侧留出 32rpx，避免贴边 */
.hscroll__item:last-child {
  margin-right: 0;
}

.hscroll__item--hover {
  transform: scale(0.97);
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.04);
}

.hscroll__img {
  width: 100%;
  height: 100%;
  display: block;
  background: #f5f5f7;
}