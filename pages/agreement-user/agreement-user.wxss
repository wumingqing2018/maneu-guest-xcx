/* pages/agreement-user/agreement-user.wxss */
page {
  background: #ffffff;
}

.doc {
  padding: 48rpx 40rpx 60rpx;
}

.doc-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 24rpx;
}

.doc-meta {
  display: flex;
  flex-direction: column;
  align-items: center;
  font-size: 24rpx;
  color: #999999;
  line-height: 1.8;
  margin-bottom: 48rpx;
}

.sec {
  margin-bottom: 40rpx;
}

.sec-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 20rpx;
}

/* rich-text 内部节点不响应外部 class，此处只靠可继承属性生效 */
.para {
  display: block;
  font-size: 28rpx;
  line-height: 1.9;
  color: #444444;
  margin-bottom: 12rpx;
  word-break: break-all;
}

/* 表格：6 列固定宽度，超出屏幕横向滚动 */
.table-wrap {
  margin: 16rpx 0 20rpx;
}

.table-scroll {
  width: 100%;
  white-space: nowrap;
}

.table {
  display: inline-block;
  border-top: 1rpx solid #e5e5e5;
  border-left: 1rpx solid #e5e5e5;
}

.tr {
  display: flex;
}

.td {
  flex: 0 0 240rpx;
  width: 240rpx;
  box-sizing: border-box;
  padding: 12rpx;
  border-right: 1rpx solid #e5e5e5;
  border-bottom: 1rpx solid #e5e5e5;
  font-size: 24rpx;
  line-height: 1.6;
  color: #444444;
  white-space: normal;
  word-break: break-all;
}

.th .td {
  background: #f7f7f7;
  font-weight: 600;
  color: #1a1a1a;
}

.doc-footer {
  text-align: center;
  font-size: 24rpx;
  color: #bbbbbb;
  padding-top: 40rpx;
}