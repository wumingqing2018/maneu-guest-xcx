<!--pages/agreement-Privacy/agreement-Privacy.wxml-->
<view class="doc">
    <view class="doc-title">{{title}}</view>
    <view class="doc-meta">
        <text>更新日期：{{updateDate}}</text>
        <text>生效日期：{{effectiveDate}}</text>
    </view>

    <view class="sec" wx:for="{{sections}}" wx:for-index="sIdx" wx:for-item="sec" wx:key="sIdx">
        <view class="sec-title" wx:if="{{sec.title}}">{{sec.title}}</view>

        <block wx:for="{{sec.blocks}}" wx:for-index="bIdx" wx:for-item="b" wx:key="bIdx">
            <!-- 普通段落 -->
            <rich-text class="para" nodes="{{b.html}}" wx:if="{{b.type === 'p'}}"></rich-text>

            <!-- 表格（横向滚动） -->
            <view class="table-wrap" wx:elif="{{b.type === 'table'}}">
                <scroll-view class="table-scroll" enhanced scroll-x show-scrollbar="{{false}}">
                    <view class="table">
                        <view class="tr th">
                            <view class="td" wx:for="{{b.head}}" wx:for-index="hIdx" wx:for-item="h"
                                  wx:key="hIdx">{{h}}</view>
                        </view>
                        <view class="tr" wx:for="{{b.rows}}" wx:for-index="rIdx" wx:for-item="row" wx:key="rIdx">
                            <view class="td" wx:for="{{row}}" wx:for-index="cIdx" wx:for-item="cell"
                                  wx:key="cIdx">{{cell}}</view>
                        </view>
                    </view>
                </scroll-view>
            </view>

            <!-- 注释 / 小字 -->
            <rich-text class="para note" nodes="{{b.html}}" wx:else></rich-text>
        </block>
    </view>

    <view class="doc-footer">— 正文结束 —</view>
</view>