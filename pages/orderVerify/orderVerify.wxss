/* ==================== 页面基础 ==================== */
page {
  background-color: #003153;
  color: #FFFFFF;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
  line-height: 1.5;
  min-height: 100vh;
}

.page {
  position: relative;
  min-height: 100vh;
  padding: 56rpx 44rpx 40rpx;
  box-sizing: border-box;
  animation: fadeInUp 0.55s cubic-bezier(0.16, 1, 0.3, 1);
}

/* 顶部径向光晕 */
.page::before {
  content: "";
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: radial-gradient(circle at 50% 0%, rgba(255, 192, 72, 0.05) 0%, transparent 60%);
  pointer-events: none;
  z-index: 0;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(20rpx); }
  to   { opacity: 1; transform: translateY(0); }
}

  /* ==================== 品牌区 ==================== */
  .brand-section {
    display: flex;
    align-items: center;
    gap: 20rpx;
    margin-bottom: 64rpx;
    padding: 32rpx 36rpx;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    border-radius: 56rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30rpx 70rpx rgba(0, 0, 0, 0.2),
      inset 0 1rpx 1rpx rgba(255, 255, 255, 0.08);
  }
  
  .brand-logo {
    width: 96rpx;
    height: 80rpx;
    flex-shrink: 0;
    filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.3));
  }
  
  .brand-text {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6rpx 12rpx;
  }
  
  .brand-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #FFC048;
    letter-spacing: 0.5rpx;
    line-height: 1.2;
    white-space: nowrap;
    flex-shrink: 0;
  }
  
  .brand-subtitle {
    font-size: 16rpx;
    font-weight: 400;
    color: #FFD580;
    letter-spacing: 0.4rpx;
    text-transform: uppercase;
    opacity: 0.8;
    white-space: nowrap;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  
/* ==================== 验证卡片 ==================== */
.verify-card {
  position: relative;
  z-index: 1;
  background: linear-gradient(135deg, rgba(255, 255, 255, 0.06) 0%, rgba(255, 255, 255, 0.02) 100%);
  -webkit-backdrop-filter: blur(24px);
  backdrop-filter: blur(24px);
  border-radius: 56rpx;
  padding: 56rpx 40rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.08);
  box-shadow: 0 30rpx 70rpx rgba(0, 0, 0, 0.2), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.08);
  min-height: 400rpx;
  box-sizing: border-box;
}

/* ==================== 骨架屏 ==================== */
.skeleton {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.04) 25%,
    rgba(255, 255, 255, 0.10) 37%,
    rgba(255, 255, 255, 0.04) 63%
  );
  background-size: 400% 100%;
  border-radius: 16rpx;
  animation: skeletonLoading 1.4s ease infinite;
}

@keyframes skeletonLoading {
  0%   { background-position: 100% 50%; }
  100% { background-position: 0 50%; }
}

.skeleton--badge {
  width: 240rpx;
  height: 48rpx;
  border-radius: 40rpx;
  margin-bottom: 32rpx;
}

.skeleton--time {
  width: 100%;
  height: 64rpx;
  border-radius: 28rpx;
  margin-bottom: 40rpx;
}

.skeleton-product {
  background: rgba(0, 0, 0, 0.2);
  border-radius: 40rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.skeleton-product .skeleton--title {
  width: 60%;
  height: 40rpx;
  margin-bottom: 24rpx;
}

.skeleton-product .skeleton--line {
  width: 100%;
  height: 28rpx;
  margin-bottom: 16rpx;
}

.skeleton-product .skeleton--line-short {
  width: 70%;
  height: 28rpx;
}

/* ==================== 状态标签 ==================== */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 40rpx;
  border-radius: 80rpx;
  font-weight: 600;
  font-size: 30rpx;
  letter-spacing: 1rpx;
  margin-bottom: 44rpx;
  text-transform: uppercase;
}

.status-badge--success {
  background: rgba(46, 204, 113, 0.12);
  color: #2ECC71;
  border: 1rpx solid rgba(46, 204, 113, 0.35);
}

.status-badge--fail {
  background: rgba(231, 76, 60, 0.12);
  color: #F1948A;
  border: 1rpx solid rgba(231, 76, 60, 0.35);
}

/* ==================== 购买时间 ==================== */
.time-section {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  padding: 28rpx 36rpx;
  background: rgba(0, 0, 0, 0.25);
  border-radius: 28rpx;
  margin-bottom: 56rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.06);
  font-size: 30rpx;
  font-weight: 500;
}

.time-key {
  color: #B0BEC5;
}

.time-val {
  color: #FFC048;
  font-weight: 600;
  margin-left: 8rpx;
  letter-spacing: 1rpx;
}

/* ==================== 失败/错误信息 ==================== */
.fail-message {
  background: rgba(231, 76, 60, 0.08);
  border: 1rpx solid rgba(231, 76, 60, 0.2);
  border-radius: 28rpx;
  padding: 32rpx 36rpx;
  color: #F1948A;
  font-weight: 500;
  font-size: 30rpx;
  line-height: 1.6;
}

/* ==================== 提示占位 ==================== */
.info-placeholder {
  text-align: center;
  color: #B0BEC5;
  font-size: 30rpx;
  padding: 40rpx 0;
  line-height: 1.6;
}

/* ==================== 产品条目 ==================== */
.product-item {
  background: rgba(0, 0, 0, 0.25);
  border-radius: 40rpx;
  padding: 40rpx 32rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.04);
  transition: all 0.2s ease;
}

.product-item:last-child {
  margin-bottom: 0;
}

.product-item--hover {
  background: rgba(0, 0, 0, 0.4);
  transform: scale(0.985);
}

/* 标题行 */
.product-title-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 192, 72, 0.2);
}

.product-name {
  font-size: 42rpx;
  font-weight: 700;
  color: #FFC048;
  letter-spacing: 1rpx;
  line-height: 1.3;
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.product-qty {
  font-size: 32rpx;
  color: #B0BEC5;
  font-weight: 500;
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* ==================== 产品元信息行（类型 · 侧别 / 单价） ==================== */
.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 28rpx;
}

.product-meta-type {
  color: #B0BEC5;
  flex-shrink: 0;
}

.product-meta-price {
  color: #FFC048;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* ==================== 详情行（key 左灰 + val 右白） ==================== */
.product-detail {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-top: 8rpx;
}

.product-detail-row {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
}

.product-detail-key {
  flex-shrink: 0;
  width: 120rpx;
  font-size: 28rpx;
  color: #B0BEC5;
  line-height: 1.6;
}

.product-detail-val {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 400;
  line-height: 1.6;
  word-break: break-all;
  text-align: right;
}