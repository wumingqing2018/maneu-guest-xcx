/* ==================== 产品元信息行（类型 · 侧别 / 单价） ==================== */
.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.08);
  font-size: 26rpx;
}

.product-meta-type {
  color: #B0BEC5;
  flex-shrink: 0;
}

.product-meta-price {
  color: #FFC048;
  font-weight: 600;
  flex-shrink: 0;
  margin-left: 20rpx;
}

/* ==================== 详情行（key 左灰 + val 右白） ==================== */
.product-detail {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 8rpx;
}

.product-detail-row {
  display: flex;
  align-items: flex-start;
  gap: 20rpx;
}

.product-detail-key {
  flex-shrink: 0;
  width: 80rpx;
  font-size: 26rpx;
  color: #B0BEC5;
  line-height: 1.6;
}

.product-detail-val {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 400;
  line-height: 1.6;
  word-break: break-all;
}