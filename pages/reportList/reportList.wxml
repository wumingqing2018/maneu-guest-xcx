<!-- pages/reportList/reportList.wxml -->
<view class="page">

<!-- ==================== 顶部标题卡 ==================== -->
<view class="card card--header">
  <text class="card__title">验光档案</text>
  <text class="card__subtitle">共 {{code}} 条记录</text>
</view>

<!-- ==================== 骨架屏 ==================== -->
<block wx:if="{{loading}}">
  <view class="report" wx:for="{{[1, 2, 3]}}" wx:key="*this">
    <view class="skeleton skeleton--line-sm"></view>
    <view class="skeleton skeleton--line"></view>
    <view class="skeleton skeleton--line"></view>
    <view class="skeleton skeleton--line"></view>
  </view>
</block>

<!-- ==================== 空状态 ==================== -->
<view wx:elif="{{!content.length}}" class="empty">
  <view class="empty__icon"></view>
  <text class="empty__title">暂无验光记录</text>
  <text class="empty__desc">下拉刷新试试</text>
</view>

<!-- ==================== 验光记录列表 ==================== -->
<block wx:else>
  <view
    class="report"
    wx:for="{{content}}"
    wx:key="id"
    bindtap="getDetail"
    data-bar_code="{{item.id}}"
  >
    <!-- 头部：时间 + 类型徽章 -->
    <view class="report__head">
      <text class="report__time">{{item.time}}</text>
      <view class="report__badge">验光</view>
    </view>

    <!-- 字段列表 -->
    <view class="report__row">
      <text class="report__label">姓名</text>
      <text class="report__value">{{item.name}}</text>
    </view>

    <view class="report__row">
      <text class="report__label">电话</text>
      <text class="report__value">{{item.phone}}</text>
    </view>

    <view class="report__row report__row--remark">
      <text class="report__label">备注</text>
      <text class="report__value">{{item.remark || '无'}}</text>
    </view>

    <!-- 底部「查看详情」 -->
    <view class="report__foot">
      <text class="report__more">查看详情</text>
      <view class="report__arrow"></view>
    </view>
  </view>
</block>

</view>