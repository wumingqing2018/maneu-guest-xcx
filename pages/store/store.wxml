<!-- pages/Store/Store.wxml -->
<view class="page">

<!-- ==================== 顶部标题 ==================== -->
<view class="hero">
  <text class="hero__label">配镜订单</text>
  <text class="hero__time">{{time || '--'}}</text>
</view>

<!-- ==================== 骨架屏 ==================== -->
<block wx:if="{{loading}}">
  <view class="card">
    <view class="card__head"><view class="skeleton skeleton--line-sm"></view></view>
    <view class="cell"><view class="skeleton skeleton--line"></view></view>
    <view class="cell"><view class="skeleton skeleton--line"></view></view>
  </view>
  <view class="card">
    <view class="card__head"><view class="skeleton skeleton--line-sm"></view></view>
    <view class="cell"><view class="skeleton skeleton--line"></view></view>
    <view class="cell"><view class="skeleton skeleton--line"></view></view>
    <view class="cell"><view class="skeleton skeleton--line"></view></view>
  </view>
</block>

<block wx:else>

  <!-- ==================== 客户信息 ==================== -->
  <view class="card">
    <view class="card__head">
      <text class="card__title">客户信息</text>
    </view>
    <view class="cell">
      <text class="cell__label">客户姓名</text>
      <text class="cell__value">{{name || '--'}}</text>
    </view>
    <view class="cell">
      <text class="cell__label">联系电话</text>
      <text class="cell__value">{{phone || '--'}}</text>
    </view>
  </view>

  <!-- ==================== 订单备注 ==================== -->
  <view class="card">
    <view class="card__head">
      <text class="card__title">订单备注</text>
    </view>
    <view class="cell">
      <text class="cell__value cell__value--block">{{remark || '无'}}</text>
    </view>
  </view>

  <!-- ==================== 验光机构 ==================== -->
  <view class="card">
    <view class="card__head">
      <text class="card__title">验光机构</text>
    </view>
    <view class="cell">
      <text class="cell__label">店铺名称</text>
      <text class="cell__value">{{admin_name || '--'}}</text>
    </view>
    <view class="cell">
      <text class="cell__label">联系电话</text>
      <text class="cell__value">{{admin_phone || '--'}}</text>
    </view>
    <view class="cell">
      <text class="cell__label">营业地址</text>
      <text class="cell__value">{{admin_location || '--'}}</text>
    </view>
    <view class="cell">
      <text class="cell__label">店铺介绍</text>
      <text class="cell__value">{{admin_content || '--'}}</text>
    </view>
  </view>

  <!-- ==================== 配镜方案（重构） ==================== -->
  <view class="card" wx:if="{{store.length}}">
    <view class="card__head">
      <text class="card__title">配镜方案</text>
      <text class="card__desc">根据您的视力检测结果，我们给您定制了以下配镜方案</text>
    </view>

    <view class="plan-list">
      <view
        class="plan"
        wx:for="{{store}}"
        wx:key="index"
        hover-class="plan--hover"
        hover-stay-time="60"
      >
        <!-- 类型 + 侧别徽章 -->
        <view class="plan__badges" wx:if="{{item.typeLabel || item.sideLabel}}">
          <text class="plan__badge plan__badge--type" wx:if="{{item.typeLabel}}">{{item.typeLabel}}</text>
          <text class="plan__badge plan__badge--side" wx:if="{{item.sideLabel}}">{{item.sideLabel}}</text>
        </view>

        <!-- 品牌 + 型号 -->
        <view class="plan__title-area" wx:if="{{item.brand || item.model}}">
          <text class="plan__brand" wx:if="{{item.brand}}">{{item.brand}}</text>
          <text class="plan__model" wx:if="{{item.model}}">{{item.model}}</text>
        </view>

        <!-- 详情列表 -->
        <view class="plan__details" wx:if="{{item.details.length > 0}}">
          <view
            class="plan__detail"
            wx:for="{{item.details}}"
            wx:for-item="d"
            wx:for-index="dIdx"
            wx:key="dIdx"
          >
            <text class="plan__detail-key">{{d.key}}</text>
            <text class="plan__detail-val {{d.isPrice ? 'plan__detail-val--price' : ''}}">{{d.val}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
</block>

</view>