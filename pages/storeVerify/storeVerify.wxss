/* pages/storeVerify/storeVerify.wxss
   ==========================================================
   深色玻璃态风格 —— 门店官方授权验证页
   ----------------------------------------------------------
   deep-blue  #003153
   gold       #FFC048
   gold-soft  #FFD580
   success    #2ECC71
   danger     #E74C3C
   ========================================================== */

   page {
    background-color: #003153;
    min-height: 100vh;
    font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
      "SF Pro Text", "Helvetica Neue", "PingFang SC", "Microsoft YaHei",
      sans-serif;
    color: #ffffff;
    -webkit-font-smoothing: antialiased;
  }
  
  .page {
    min-height: 100vh;
    padding: 56rpx 44rpx 40rpx;
    box-sizing: border-box;
    position: relative;
    background-image: radial-gradient(
      circle at 50% 0%,
      rgba(255, 192, 72, 0.06) 0%,
      transparent 60%
    );
    background-color: #003153;
    animation: fadeInUp 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(40rpx);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  /* ==================== 品牌区 ==================== */
  .brand-section {
    display: flex;
    align-items: center;
    gap: 20rpx;
    margin-bottom: 64rpx;
    padding: 32rpx 36rpx;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    border-radius: 56rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30rpx 70rpx rgba(0, 0, 0, 0.2),
      inset 0 1rpx 1rpx rgba(255, 255, 255, 0.08);
  }
  
  .brand-logo {
    width: 96rpx;
    height: 80rpx;
    flex-shrink: 0;
    filter: drop-shadow(0 8rpx 16rpx rgba(0, 0, 0, 0.3));
  }
  
  .brand-text {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 6rpx 12rpx;
  }
  
  .brand-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #FFC048;
    letter-spacing: 0.5rpx;
    line-height: 1.2;
    white-space: nowrap;
    flex-shrink: 0;
  }
  
  .brand-subtitle {
    font-size: 16rpx;
    font-weight: 400;
    color: #FFD580;
    letter-spacing: 0.4rpx;
    text-transform: uppercase;
    opacity: 0.8;
    white-space: nowrap;
    flex-shrink: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  
  /* ==================== 验证卡片 ==================== */
  .verify-card {
    position: relative;
    background: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.06) 0%,
      rgba(255, 255, 255, 0.02) 100%
    );
    border-radius: 56rpx;
    padding: 56rpx 40rpx;
    margin-bottom: 56rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 30rpx 70rpx rgba(0, 0, 0, 0.2),
      inset 0 1rpx 1rpx rgba(255, 255, 255, 0.08);
    min-height: 400rpx;
    box-sizing: border-box;
  }
  
  /* ==================== 骨架屏 ==================== */
  .skeleton {
    background: linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.04) 25%,
      rgba(255, 255, 255, 0.1) 37%,
      rgba(255, 255, 255, 0.04) 63%
    );
    background-size: 400% 100%;
    animation: shimmer 1.4s ease-in-out infinite;
    border-radius: 12rpx;
  }
  
  @keyframes shimmer {
    0% {
      background-position: 100% 0;
    }
    100% {
      background-position: -100% 0;
    }
  }
  
  /* 状态徽章骨架 */
  .skeleton--badge {
    width: 220rpx;
    height: 56rpx;
    border-radius: 80rpx;
    margin-bottom: 44rpx;
  }
  
  /* 购买时间骨架 */
  .skeleton--time {
    width: 100%;
    height: 88rpx;
    border-radius: 28rpx;
    margin-bottom: 56rpx;
  }
  
  /* 产品条目骨架容器 */
  .skeleton-product {
    background: rgba(0, 0, 0, 0.15);
    border-radius: 40rpx;
    padding: 40rpx 32rpx;
    margin-bottom: 36rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.03);
  }
  
  .skeleton-product:last-child {
    margin-bottom: 0;
  }
  
  /* 主标题行骨架 */
  .skeleton--title {
    width: 70%;
    height: 48rpx;
    border-radius: 12rpx;
    margin-bottom: 32rpx;
  }
  
  /* 属性行骨架 */
  .skeleton--line {
    width: 100%;
    height: 32rpx;
    margin-bottom: 20rpx;
  }
  
  .skeleton--line:last-child {
    margin-bottom: 0;
  }
  
  /* 短属性行骨架 */
  .skeleton--line-short {
    width: 60%;
    height: 32rpx;
  }
  
  /* ---------- 提示占位 ---------- */
  .info-placeholder {
    text-align: center;
    color: #B0BEC5;
    font-size: 28rpx;
    padding: 60rpx 0;
    line-height: 1.6;
  }
  
  .error-block {
    padding: 20rpx 0;
  }
  
  /* ==================== 状态徽章 ==================== */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 16rpx;
    padding: 12rpx 40rpx;
    border-radius: 80rpx;
    font-weight: 600;
    font-size: 26rpx;
    letter-spacing: 1rpx;
    margin-bottom: 44rpx;
  }
  
  .status-badge--success {
    background: rgba(46, 204, 113, 0.12);
    color: #2ECC71;
    border: 1rpx solid rgba(46, 204, 113, 0.35);
  }
  
  .status-badge--fail {
    background: rgba(231, 76, 60, 0.12);
    color: #F1948A;
    border: 1rpx solid rgba(231, 76, 60, 0.35);
  }
  
  /* ==================== 购买时间 ==================== */
  .time-section {
    padding: 28rpx 36rpx;
    background: rgba(0, 0, 0, 0.25);
    border-radius: 28rpx;
    margin-bottom: 56rpx;
    font-size: 30rpx;
    color: #B0BEC5;
    border: 1rpx solid rgba(255, 255, 255, 0.06);
    font-weight: 500;
  }
  
  .time-key {
    font-weight: 600;
  }
  
  .time-val {
    color: #FFC048;
    font-weight: 600;
    margin-left: 8rpx;
    letter-spacing: 0.6rpx;
  }
  
  /* ==================== 失败消息 ==================== */
  .fail-message {
    background: rgba(231, 76, 60, 0.08);
    border: 1rpx solid rgba(231, 76, 60, 0.2);
    border-radius: 28rpx;
    padding: 32rpx 36rpx;
    color: #F1948A;
    font-weight: 500;
    margin-bottom: 40rpx;
    font-size: 30rpx;
    line-height: 1.6;
  }
  
  /* ==================== 产品条目 ==================== */
  .product-item {
    background: rgba(0, 0, 0, 0.25);
    border-radius: 40rpx;
    padding: 40rpx 32rpx;
    margin-bottom: 36rpx;
    border: 1rpx solid rgba(255, 255, 255, 0.04);
    transition: background 0.2s ease, transform 0.2s ease;
  }
  
  .product-item:last-child {
    margin-bottom: 0;
  }
  
  .product-item--hover {
    background: rgba(0, 0, 0, 0.4);
    transform: scale(0.985);
  }
  
  /* ---------- 主标题行 ---------- */
  .first-property {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 12rpx;
    padding-bottom: 24rpx;
    margin-bottom: 24rpx;
    border-bottom: 1rpx solid rgba(255, 192, 72, 0.2);
  }
  
  .first-key {
    min-width: 160rpx;
    font-size: 38rpx;
    color: #B0BEC5;
    font-weight: 500;
    letter-spacing: 0.4rpx;
  }
  
  .divider {
    font-size: 38rpx;
    color: rgba(255, 192, 72, 0.5);
  }
  
  .first-val {
    font-size: 38rpx;
    color: #FFC048;
    font-weight: 700;
    letter-spacing: 0.4rpx;
    word-break: break-all;
    flex: 1;
    min-width: 0;
  }
  
  /* ---------- 其余属性网格 ---------- */
  .props-grid {
    display: flex;
    flex-direction: column;
    gap: 18rpx;
  }
  
  .prop-item {
    display: flex;
    align-items: flex-start;
    gap: 32rpx;                /* ✅ 从 24rpx 加大到 32rpx */
    padding: 8rpx 0;           /* ✅ 从 4rpx 加大到 8rpx */
  }
  
  .prop-key {
    flex-shrink: 0;
    width: 160rpx;             /* ✅ 从 min-width 改成 width，严格对齐 */
    font-size: 28rpx;
    color: #B0BEC5;
    line-height: 1.6;
  }
  
  .prop-val {
    flex: 1;
    min-width: 0;              /* ✅ 允许 flex 收缩，长文本换行 */
    font-size: 28rpx;
    color: #FFFFFF;
    font-weight: 500;
    text-align: left;
    word-break: break-all;
    line-height: 1.6;
  }