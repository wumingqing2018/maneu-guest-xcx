/* pages/storeVerify/storeVerify.wxss
   Apple 浅色风格 —— 门店官方授权验证页
   bg #FBFBFD / surface #FFF / accent #0071E3 / success #0071E3 / danger #FF3B30
*/

page {
  background: #fbfbfd;
  min-height: 100vh;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display",
  "SF Pro Text", "Helvetica Neue", "PingFang SC", "Microsoft YaHei",
  sans-serif;
  color: #1d1d1f;
  -webkit-font-smoothing: antialiased;
}

.page {
  min-height: 100vh;
  padding: 24rpx 0 calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

/* ==================== 品牌区 ==================== */
.brand-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin: 0 32rpx 24rpx;
  padding: 32rpx 36rpx;
  background: #ffffff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03),
  0 16rpx 40rpx rgba(0, 0, 0, 0.06);
  box-sizing: border-box;
}

.brand-logo {
  width: 96rpx;
  height: 80rpx;
  flex-shrink: 0;
}

.brand-text {
  flex: 1;
  min-width: 0;
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 6rpx 12rpx;
}

.brand-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1d1d1f;
  letter-spacing: -0.2rpx;
  line-height: 1.2;
  white-space: nowrap;
  flex-shrink: 0;
}

.brand-subtitle {
  font-size: 20rpx;
  color: #86868b;
  letter-spacing: 0.4rpx;
  text-transform: uppercase;
  white-space: nowrap;
  flex-shrink: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  min-width: 0;
}

/* ==================== 验证卡片 ==================== */
.verify-card {
  position: relative;
  background: #ffffff;
  border-radius: 24rpx;
  padding: 40rpx 36rpx;
  margin: 0 32rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03),
  0 16rpx 40rpx rgba(0, 0, 0, 0.06);
  min-height: 400rpx;
  box-sizing: border-box;
}

/* ==================== 骨架屏 ==================== */
.skeleton {
  background: linear-gradient(90deg, #eef0f3 25%, #f7f8fa 37%, #eef0f3 63%);
  background-size: 400% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
  border-radius: 12rpx;
}

@keyframes shimmer {
  0% {
      background-position: 100% 0;
  }
  100% {
      background-position: -100% 0;
  }
}

.skeleton--badge {
  width: 240rpx;
  height: 56rpx;
  border-radius: 80rpx;
  margin-bottom: 36rpx;
}

.skeleton--time {
  width: 100%;
  height: 88rpx;
  border-radius: 20rpx;
  margin-bottom: 36rpx;
}

.skeleton-product {
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
}

.skeleton-product:last-child {
  margin-bottom: 0;
}

.skeleton--title {
  width: 50%;
  height: 40rpx;
  border-radius: 12rpx;
  margin-bottom: 28rpx;
}

.skeleton--line {
  width: 100%;
  height: 28rpx;
  margin-bottom: 16rpx;
}

.skeleton--line:last-child {
  margin-bottom: 0;
}

.skeleton--line-short {
  width: 60%;
  height: 28rpx;
}

/* ==================== 提示占位 ==================== */
.info-placeholder {
  text-align: center;
  color: #86868b;
  font-size: 28rpx;
  padding: 60rpx 0;
  line-height: 1.6;
}

.error-block {
  padding: 20rpx 0;
}

/* ==================== 状态徽章（成功蓝色） ==================== */
.status-badge {
  display: inline-flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 32rpx;
  border-radius: 80rpx;
  font-weight: 600;
  font-size: 26rpx;
  letter-spacing: 0.5rpx;
  margin-bottom: 36rpx;
}

.status-badge--success {
  background: rgba(0, 113, 227, 0.1);
  color: #0071e3;
}

.status-badge--fail {
  background: rgba(255, 59, 48, 0.1);
  color: #ff3b30;
}

/* ==================== 购买时间 ==================== */
.time-section {
  display: flex;
  align-items: baseline;
  flex-wrap: wrap;
  gap: 0 24rpx;
  padding: 24rpx 28rpx;
  background: #f7f8fa;
  border-radius: 20rpx;
  margin-bottom: 36rpx;
  font-size: 28rpx;
  color: #86868b;
}

.time-key {
  width: 160rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.time-val {
  color: #1d1d1f;
  min-width: 0;
  word-break: break-all;
}

/* ==================== 失败消息 ==================== */
.fail-message {
  background: rgba(255, 59, 48, 0.06);
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  color: #ff3b30;
  font-weight: 500;
  margin-bottom: 32rpx;
  font-size: 28rpx;
  line-height: 1.6;
}

/* ==================== 产品条目 ==================== */
.product-item {
  background: #f7f8fa;
  border-radius: 20rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  transition: background 0.2s ease, transform 0.2s ease;
}

.product-item:last-child {
  margin-bottom: 0;
}

.product-item--hover {
  background: #eef0f3;
  transform: scale(0.985);
}

/* ---------- 主标题行 ---------- */
.first-property {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx 24rpx;
  padding-bottom: 20rpx;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.first-key {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 30rpx;
  color: #86868b;
  font-weight: 500;
  letter-spacing: 0.2rpx;
}

.first-val {
  font-size: 32rpx;
  color: #1d1d1f;
  letter-spacing: -0.2rpx;
  word-break: break-all;
  flex: 1;
  min-width: 0;
}

/* ---------- 其余属性 ---------- */
.props-grid {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.prop-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 6rpx 0;
}

.prop-key {
  width: 160rpx;
  flex-shrink: 0;
  font-size: 28rpx;
  color: #86868b;
  line-height: 1.6;
}

.prop-val {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: #1d1d1f;
  font-weight: 500;
  text-align: left;
  word-break: break-all;
  line-height: 1.6;
}