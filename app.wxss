/**app.wxss**/

/* pages/wxcharts/wxcharts.wxss */
page {
  height: 100%;
}

.h5 {
  font-weight: bold;
  font-size: 35rpx;
  padding: 2%;
}

.h4 {
  padding: 2%;
  border-top: 1px solid;
}

.canvas {
  width: 750rpx;
  height: 400rpx;
}

.navBox {
  /* tab整体样式 */
  height: 100rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.fontColorBox {
  /* 选中tab样式 */
  color: black;
  font-weight: bold;
}

.titleBox {
  /* 未选中tab样式 */
  color: rgb(168, 170, 175);
  font-size: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.lineBox {
  /* 线条样式 */
  width: 32rpx;
  height: 8rpx;
  background: black;
  margin-top: 10rpx;
  border-radius: 4rpx;
}

.swiperTtemBox {
  /* 内容样式 */
  padding: 16rpx;
  font-size: 28rpx;
  height: calc(40vh - 150rpx);
}

.card {
  background-color: #ffffff;
  border-radius: 20px;
  padding-top: 10px;
  padding-bottom: 10px;
}

.blue {
  padding: 10px;
  background: #d6eef8;
  font-weight: bold;
}

.somke {
  padding: 5px;
  background: #f6f4f4;
}

.white {
  padding: 5px;
  background: #ffffff;
}

.fr1 {
  text-align: center;
  display: grid;
  grid-template-columns: 1fr;
}

.fr2 {
  text-align: center;
  display: grid;
  grid-template-columns: 1fr 2fr;
}

.fr3 {
  text-align: center;
  display: grid;
  grid-template-columns: 1fr 1fr 1fr;
}